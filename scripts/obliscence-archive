#!/usr/bin/env python3
"""Move Spelean Rings into the Hollows, verbatim.

Derived from the portable archiver. Selection now uses dates, byte slices preserve
line endings and EOF, and a journal makes interrupted multi-file moves resumable.
Archives only gain bytes. The recent file is replaced last, after SHA-256 checks.
Keep every leaf of the boundary date, even when that exceeds keep. Keep undated
leaves in place. With keep 0, move every dated leaf.
Usage: obliscence-archive [--dry-run] [--keep N] [--vault DIR]
"""
from __future__ import annotations
import argparse
import base64
import fcntl
import hashlib
import json
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _obliscence import archive_candidates, atomic_write, confined, find_vault, load_config, split_leaves


def digest(data):
    return hashlib.sha256(data).hexdigest()


def read_bytes(path):
    return path.read_bytes() if path.exists() else None


def encode(data):
    return base64.b64encode(data).decode('ascii') if data is not None else None


def decode(data):
    return base64.b64decode(data, validate=True) if data is not None else None


def planned_write(vault, path, before, after, mode):
    return {'path': str(path.relative_to(Path(vault).resolve())), 'before': encode(before),
            'after': encode(after), 'sha256': digest(after), 'mode': mode}


def apply_transaction(vault, cfg, journal):
    """Accept only the planned before/after states. Never overwrite a later edit."""
    transaction = json.loads(journal.read_text())
    writes = transaction['writes']
    diary = confined(vault, cfg['diary'])
    archive = confined(vault, cfg['archive_dir'])
    if not writes or confined(vault, writes[-1]['path']) != diary:
        raise ValueError('archive journal does not match this diary; retained for review')
    checked = []
    for i, item in enumerate(writes):
        path = confined(vault, item['path'])
        if i < len(writes) - 1 and (path.parent != archive or not path.name.endswith('.md')):
            raise ValueError('archive journal has an unexpected destination')
        before, after = decode(item['before']), decode(item['after'])
        if after is None or digest(after) != item['sha256']:
            raise ValueError('archive journal integrity check failed')
        if path != diary and not after.startswith(before or b''):
            raise ValueError('archive journal would replace existing archive bytes')
        if read_bytes(path) not in (before, after):
            raise ValueError(f'{item["path"]} changed since the move began; journal retained, no recovery writes made')
        mode = item.get('mode', diary.stat().st_mode & 0o777)
        if type(mode) is not int or not 0 <= mode <= 0o777:
            raise ValueError('archive journal has an invalid file mode')
        checked.append((path, before, after, mode))
    for path, before, after, mode in checked:
        current = read_bytes(path)
        if current == after:
            continue  # a prior invocation already committed this exact step
        if current != before:
            raise ValueError(f'{path.name} changed during archiving; journal retained')
        atomic_write(path, after, mode=mode)
        if digest(path.read_bytes()) != digest(after):
            raise OSError(f'integrity check failed for {path.name}; journal retained')
    journal.unlink()
    print('obliscence-archive: move verified; every leaf kept whole')


def archive(vault, cfg, keep, dry):
    diary = confined(vault, cfg['diary'])
    archive_dir = confined(vault, cfg['archive_dir'])
    journal = confined(vault, '.obliscence/archive-transaction.json')
    if journal.exists():
        if dry:
            print('obliscence-archive: an interrupted move awaits recovery; run without --dry-run to verify and finish it')
            return 1
        apply_transaction(vault, cfg, journal)
        return 0
    original = diary.read_bytes()
    source_mode = diary.stat().st_mode & 0o777
    newline = b'\r\n' if original.split(b'\n', 1)[0].endswith(b'\r') else b'\n'
    preamble, entries = split_leaves(original)
    moving = archive_candidates(entries, keep)
    if not moving:
        print(f'obliscence-archive: {len(entries)} entries, keep {keep} dated — nothing to archive')
        return 0
    by_month = {}
    for i, entry in enumerate(entries):
        if i in moving:
            by_month.setdefault(entry['date'].strftime('%Y-%m'), []).append(entry)
    writes = []
    for month, leaves in sorted(by_month.items()):
        path = confined(vault, str(Path(cfg['archive_dir']) / (month + '.md')))
        existing = read_bytes(path)
        prefix = existing if existing is not None else f'# {month} — Spelean Rings (verbatim, append-only)'.encode() + newline * 2
        container_newline = (b'\r\n' if prefix.split(b'\n', 1)[0].endswith(b'\r') else b'\n') if b'\n' in prefix else newline
        separator = b'' if not prefix or prefix.endswith(container_newline * 2) else (container_newline if prefix.endswith(b'\n') else container_newline * 2)
        # No newline is added to any leaf, even one at EOF. Separators belong to
        # the archive container; exact source slices and duplicate leaves survive.
        chunk = b''.join(e['raw'] for e in leaves)
        after = prefix + separator + chunk
        assert digest(after[len(prefix) + len(separator):]) == digest(chunk)
        writes.append(planned_write(vault, path, existing, after, source_mode))
        print(f'{"would move" if dry else "moving"} {len(leaves)} → {cfg["archive_dir"]}/{month}.md')
        for entry in leaves:
            print('    ' + entry['heading'])
    remaining = preamble + b''.join(e['raw'] for i, e in enumerate(entries) if i not in moving)
    writes.append(planned_write(vault, diary, original, remaining, source_mode))
    if dry:
        return 0
    atomic_write(journal, json.dumps({'version': 1, 'writes': writes}, indent=2).encode())
    apply_transaction(vault, cfg, journal)
    return 0


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--vault')
    parser.add_argument('--keep', type=int)
    parser.add_argument('--dry-run', action='store_true')
    args = parser.parse_args(argv[1:])
    vault = str(Path(args.vault).resolve()) if args.vault else find_vault(os.getcwd())
    if not vault:
        raise ValueError('no obliscence.json or sillage.json; run obliscence --init')
    cfg = load_config(vault)
    keep = args.keep if args.keep is not None else cfg['keep']
    if keep < 0:
        raise ValueError('--keep must be nonnegative')
    if not cfg['diary'] or not cfg['archive_dir']:
        print('obliscence-archive: diary or archive_dir not planted; nothing moved')
        return 0
    if args.dry_run:
        return archive(vault, cfg, keep, True)
    lock = confined(vault, '.obliscence/archive.lock')
    lock.parent.mkdir(parents=True, exist_ok=True)
    with lock.open('a+b') as stream:
        try:
            fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError('another archive move is running; try after it finishes') from None
        return archive(vault, cfg, keep, False)


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv))
    except (OSError, ValueError, TypeError, KeyError) as error:
        print(f'obliscence-archive: {error}', file=sys.stderr)
        sys.exit(2)
